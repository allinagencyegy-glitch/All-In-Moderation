# All In Moderation — Phase 0 environment template
#
# Copy to `.env` and adjust. Every value below has a safe default in src/runtime/config.ts, so an
# empty file boots. Configuration is validated eagerly at start-up: a bad value fails the process
# on boot rather than on the first customer message.
#
# Secrets are deliberately NOT read from here. Channel credentials are resolved by reference
# through the `SecretResolver` port (`secret://...`), so a config dump cannot leak them. Phase 0
# ships an in-memory resolver only.

# --- process ------------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# web | worker | all — which half of the system this process runs. Phase 0 has no HTTP server yet.
APP_ROLE=all
# debug | info | warn | error
LOG_LEVEL=info

# --- outbound safety ----------------------------------------------------------------------------
# SIMULATE | LIVE
#
# Phase 0 is SIMULATE and LIVE is REFUSED AT BOOT. There is no provider transport, and a config
# flag must never be the only thing standing between a test environment and a real customer's
# inbox. Setting LIVE throws OUTBOUND_LIVE_NOT_AUTHORIZED.
OUTBOUND_MODE=SIMULATE

# --- durable job queue (ADR-004) ------------------------------------------------------------------
# How long a worker holds a job before the reaper may reclaim it. Must exceed the slowest handler,
# or a live handler and a reclaiming worker end up writing to the same conversation.
WORKER_LEASE_MS=60000
# Poll interval for claiming ready jobs. Polling is the correctness mechanism; LISTEN/NOTIFY is a
# Phase 1 latency optimisation, not a replacement.
WORKER_POLL_INTERVAL_MS=1000
# Bounded retry. On exhaustion a job is dead-lettered, recorded, and — for moderator work — a
# human handoff is raised. There is no unbounded retry path.
WORKER_MAX_ATTEMPTS=5

# --- language model (ADR-007) ---------------------------------------------------------------------
# Phase 0 ships `mock` only. No network call is made anywhere in this phase.
LLM_PROVIDER=mock
LLM_REASON_MODEL=mock-model-1
LLM_TIMEOUT_MS=20000
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# --- ingest -------------------------------------------------------------------------------------
# Hard cap on a webhook body, enforced before parsing. Oversized bodies are rejected, not buffered.
INGEST_MAX_BODY_BYTES=1000000

# --- Phase 1 placeholders (not read by any Phase 0 code) --------------------------------------------
# DATABASE_URL=postgres://app_runtime:password@localhost:5432/all_in_moderation
# META_APP_SECRET_REF=secret://meta/app-secret
